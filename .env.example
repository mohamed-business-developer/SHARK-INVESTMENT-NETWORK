# ==============================================================================
# SHARK Investment Network — Root Environment Template
# ==============================================================================
# Copy this file to .env for local tooling / CI references ONLY.
# NEVER commit .env or .env.local files containing real secrets!
# App-specific templates live in:
#   - apps/mobile/.env.example
#   - apps/admin/.env.example
# ==============================================================================

# Shared Supabase Project Reference (Dev / Staging)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Server / CI Only (NEVER prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Edge Function Configuration
SIGNED_URL_TTL_SECONDS=120
APP_ENV=development
EXPO_ACCESS_TOKEN=your-expo-access-token-server-only

# CI / Release Tooling
SENTRY_AUTH_TOKEN=your-sentry-auth-token-ci-only
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
