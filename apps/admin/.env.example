# ==============================================================================
# SHARK Admin Dashboard — Environment Template
# ==============================================================================
# Copy to apps/admin/.env.local for local development.
# NEVER commit .env.local and NEVER prefix server secrets with NEXT_PUBLIC_!
# Reference: docs/ARCHITECTURE.md Sections 10.2 & 10.3
# ==============================================================================

# Public Browser Bundle Variables (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SENTRY_DSN=

# Server-Only Secrets (NEVER expose in client components or NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
