# ==============================================================================
# SHARK Mobile App — Public Client Environment Template
# ==============================================================================
# Copy to apps/mobile/.env.local for local development.
# NEVER put server-only service role secrets in EXPO_PUBLIC_* variables!
# Reference: docs/ARCHITECTURE.md Section 10.1 & docs/SECURITY.md Section 8.1
# ==============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEFAULT_LOCALE=ar
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_EAS_PROJECT_ID=
